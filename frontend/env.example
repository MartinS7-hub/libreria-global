# Variables del servicio frontend (Nginx). Copiar a un archivo .env local
# (NO versionar) o cargar en Environment del servicio de Easypanel.

# Host y puerto internos del backend. Formato host:puerto, sin http:// ni
# barra final. Nginx reemplaza esta variable en default.conf.template.
#
#   Local con Docker Desktop:  host.docker.internal:8000
#   Easypanel (mismo proyecto): <proyecto>_<servicio>:8000   (ej.: app_grup02_libreria_backend:8000)
API_UPSTREAM=host.docker.internal:8000
